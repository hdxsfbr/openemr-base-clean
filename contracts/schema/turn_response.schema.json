{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "facts": {
          "$ref": "#/$defs/ClaimFacts"
        },
        "id": {
          "pattern": "^c[0-9]{1,3}$",
          "title": "Id",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "source_ids": {
          "items": {
            "maxLength": 240,
            "pattern": "^(openemr|document|guideline):[A-Za-z0-9_\\-.:]{1,200}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Source Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ClaimType"
        }
      },
      "required": [
        "id",
        "type",
        "text"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimFacts": {
      "additionalProperties": false,
      "description": "Typed facts the verifier checks field by field. Flat so structured\noutput can emit it reliably; each claim type uses its own subset.",
      "properties": {
        "analyte": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_result, lab_comparison",
          "title": "Analyte"
        },
        "date": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM-DD for change_event and lab_result",
          "title": "Date"
        },
        "direction": {
          "anyOf": [
            {
              "maxLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_comparison: up|down|same",
          "title": "Direction"
        },
        "earlier_source_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_comparison",
          "title": "Earlier Source Id"
        },
        "flag": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_result: abnormal|normal|unknown",
          "title": "Flag"
        },
        "kind": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "change_event: added|ended|started|stopped|resulted|noted; conflict: status_conflict|note_vs_list|duplicate_sources",
          "title": "Kind"
        },
        "later_source_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_comparison",
          "title": "Later Source Id"
        },
        "medication_name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "documented_reference",
          "title": "Medication Name"
        },
        "mention": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "documented_reference: short quote from the cited note",
          "title": "Mention"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "medication_status: medication name; problem_status: problem title as written",
          "title": "Name"
        },
        "reading": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "interpretation: your reading of an ambiguous reference",
          "title": "Reading"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "change_event, absence, undated",
          "title": "Section"
        },
        "state": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "absence: not_documented|reviewed_none|no_records_in_window",
          "title": "State"
        },
        "status": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "medication_status, problem_status: active|inactive|unknown",
          "title": "Status"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_result: exactly as in the pack, null if missing",
          "title": "Unit"
        },
        "value_text": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_result: exactly as in the pack",
          "title": "Value Text"
        }
      },
      "title": "ClaimFacts",
      "type": "object"
    },
    "ClaimType": {
      "enum": [
        "change_event",
        "medication_status",
        "problem_status",
        "lab_result",
        "lab_comparison",
        "documented_reference",
        "absence",
        "conflict",
        "undated",
        "interpretation"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "EvidenceSummary": {
      "additionalProperties": false,
      "properties": {
        "absence_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Absence State"
        },
        "record_count": {
          "title": "Record Count",
          "type": "integer"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "tool",
        "status",
        "record_count"
      ],
      "title": "EvidenceSummary",
      "type": "object"
    },
    "Limitation": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "maxLength": 300,
          "title": "Detail",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/LimitationKind"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "source_ids": {
          "items": {
            "maxLength": 240,
            "pattern": "^(openemr|document|guideline):[A-Za-z0-9_\\-.:]{1,200}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "title": "Limitation",
      "type": "object"
    },
    "LimitationKind": {
      "enum": [
        "not_documented",
        "reviewed_none",
        "unavailable",
        "truncated",
        "conflict",
        "undated",
        "withheld",
        "out_of_scope",
        "narrative_unavailable",
        "model_budget_exhausted"
      ],
      "title": "LimitationKind",
      "type": "string"
    },
    "SourceSummary": {
      "additionalProperties": false,
      "description": "A cited record the panel can open in the chart (CAP-05).",
      "properties": {
        "encounter_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encounter Id"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "label": {
          "maxLength": 160,
          "title": "Label",
          "type": "string"
        },
        "order_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Id"
        },
        "source_id": {
          "maxLength": 240,
          "pattern": "^(openemr|document|guideline):[A-Za-z0-9_\\-.:]{1,200}$",
          "title": "Source Id",
          "type": "string"
        },
        "table": {
          "maxLength": 64,
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "table",
        "id",
        "label"
      ],
      "title": "SourceSummary",
      "type": "object"
    },
    "Verification": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "pattern": "^(passed|partial|rejected|not_run|failed_closed)$",
          "title": "Outcome",
          "type": "string"
        },
        "rejected": {
          "description": "{claim_id, rule, detail}",
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Rejected",
          "type": "array"
        },
        "repair_attempted": {
          "default": false,
          "title": "Repair Attempted",
          "type": "boolean"
        },
        "rules_applied": {
          "items": {
            "type": "string"
          },
          "title": "Rules Applied",
          "type": "array"
        }
      },
      "required": [
        "outcome"
      ],
      "title": "Verification",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answered_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "UTC time the answer was rendered (ISO 8601); shown so a restored transcript reads as history",
      "title": "Answered At"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "contract_version": {
      "title": "Contract Version",
      "type": "string"
    },
    "conversation_id": {
      "title": "Conversation Id",
      "type": "string"
    },
    "correlation_id": {
      "pattern": "^[A-Za-z0-9\\-._]{8,64}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceSummary"
      },
      "title": "Evidence",
      "type": "array"
    },
    "limitations": {
      "items": {
        "$ref": "#/$defs/Limitation"
      },
      "title": "Limitations",
      "type": "array"
    },
    "reference_encounter_source_id": {
      "anyOf": [
        {
          "maxLength": 240,
          "pattern": "^(openemr|document|guideline):[A-Za-z0-9_\\-.:]{1,200}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Encounter Source Id"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceSummary"
      },
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "pattern": "^(complete|partial|fallback|denied|failed)$",
      "title": "Status",
      "type": "string"
    },
    "suggestions": {
      "description": "Follow-up questions offered as chips; lexicon-filtered, never facts",
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "title": "Suggestions",
      "type": "array"
    },
    "summary": {
      "default": "",
      "description": "Paragraph shown above the claims",
      "maxLength": 600,
      "title": "Summary",
      "type": "string"
    },
    "summary_basis": {
      "default": "none",
      "description": "model: the model's summary, accepted because every claim verified; deterministic: built from verified claims",
      "pattern": "^(model|deterministic|none)$",
      "title": "Summary Basis",
      "type": "string"
    },
    "turn_id": {
      "title": "Turn Id",
      "type": "string"
    },
    "turn_type": {
      "pattern": "^(uc01_first|followup)$",
      "title": "Turn Type",
      "type": "string"
    },
    "usage": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          }
        ]
      },
      "title": "Usage",
      "type": "object"
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    },
    "window_since": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Window Since"
    },
    "withheld_count": {
      "default": 0,
      "title": "Withheld Count",
      "type": "integer"
    }
  },
  "required": [
    "turn_id",
    "conversation_id",
    "turn_type",
    "status",
    "verification",
    "correlation_id",
    "contract_version"
  ],
  "title": "TurnResponse",
  "type": "object",
  "x-contract-version": "1.2.0"
}
