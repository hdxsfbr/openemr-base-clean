{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "facts": {
          "$ref": "#/$defs/ClaimFacts"
        },
        "id": {
          "pattern": "^c[0-9]{1,3}$",
          "title": "Id",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "source_ids": {
          "items": {
            "maxLength": 240,
            "pattern": "^(openemr|document|guideline):[A-Za-z0-9_\\-.:]{1,200}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Source Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ClaimType"
        }
      },
      "required": [
        "id",
        "type",
        "text"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimFacts": {
      "additionalProperties": false,
      "description": "Typed facts the verifier checks field by field. Flat so structured\noutput can emit it reliably; each claim type uses its own subset.",
      "properties": {
        "analyte": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_result, lab_comparison",
          "title": "Analyte"
        },
        "date": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM-DD for change_event and lab_result",
          "title": "Date"
        },
        "direction": {
          "anyOf": [
            {
              "maxLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_comparison: up|down|same",
          "title": "Direction"
        },
        "earlier_source_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_comparison",
          "title": "Earlier Source Id"
        },
        "flag": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_result: abnormal|normal|unknown",
          "title": "Flag"
        },
        "kind": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "change_event: added|ended|started|stopped|resulted|noted; conflict: status_conflict|note_vs_list|duplicate_sources",
          "title": "Kind"
        },
        "later_source_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_comparison",
          "title": "Later Source Id"
        },
        "medication_name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "documented_reference",
          "title": "Medication Name"
        },
        "mention": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "documented_reference: short quote from the cited note",
          "title": "Mention"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "medication_status: medication name",
          "title": "Name"
        },
        "reading": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "interpretation: your reading of an ambiguous reference",
          "title": "Reading"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "change_event, absence, undated",
          "title": "Section"
        },
        "state": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "absence: not_documented|reviewed_none|no_records_in_window",
          "title": "State"
        },
        "status": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "medication_status: active|inactive|unknown",
          "title": "Status"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_result: exactly as in the pack, null if missing",
          "title": "Unit"
        },
        "value_text": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_result: exactly as in the pack",
          "title": "Value Text"
        }
      },
      "title": "ClaimFacts",
      "type": "object"
    },
    "ClaimType": {
      "enum": [
        "change_event",
        "medication_status",
        "lab_result",
        "lab_comparison",
        "documented_reference",
        "absence",
        "conflict",
        "undated",
        "interpretation"
      ],
      "title": "ClaimType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The model's structured output. Nothing here is displayed until verified.",
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 40,
      "title": "Claims",
      "type": "array"
    },
    "suggestions": {
      "description": "Follow-up questions about this chart the physician could ask next",
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "title": "Suggestions",
      "type": "array"
    },
    "summary": {
      "default": "",
      "description": "One to three sentences that answer the question by restating the claims; shown only when every claim verified",
      "maxLength": 600,
      "title": "Summary",
      "type": "string"
    }
  },
  "title": "TurnClaims",
  "type": "object",
  "x-contract-version": "1.1.0"
}
