        "test_name": {
          "$ref": "#/$defs/ProposedField_Annotated_str__FieldInfo_annotation_NoneType__required_True__metadata__MinLen_min_length_1___MaxLen_max_length_200_____"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposedField_Annotated_str__FieldInfo_annotation_NoneType__required_True__metadata__MinLen_min_length_1___MaxLen_max_length_80_____"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "$ref": "#/$defs/ProposedField_Annotated_Union_QuantityValue__TextValue___FieldInfo_annotation_NoneType__required_True__discriminator__kind____"
        }
      },
      "required": [
        "analyte_id",
        "test_name",
        "value"
