{
  "$defs": {
    "CodedValue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "display": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display"
        },
        "system": {
          "maxLength": 500,
          "minLength": 1,
          "title": "System",
          "type": "string"
        }
      },
      "required": [
        "system",
        "code"
      ],
      "title": "CodedValue",
      "type": "object"
    },
    "ExtractionState": {
      "enum": [
        "schema_valid",
        "review_required",
        "rejected",
        "unavailable"
      ],
      "title": "ExtractionState",
      "type": "string"
    },
    "FieldEvidence": {
      "additionalProperties": false,
      "properties": {
        "box": {
          "$ref": "#/$defs/NormalizedBox"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Confidence"
        },
        "evidence_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "ocr_span_end": {
          "minimum": 1,
          "title": "Ocr Span End",
          "type": "integer"
        },
        "ocr_span_start": {
          "minimum": 0,
          "title": "Ocr Span Start",
          "type": "integer"
        },
        "ocr_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ocr Text Sha256",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "printed_quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Printed Quote",
          "type": "string"
        },
        "rendered_page_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rendered Page Sha256",
          "type": "string"
        },
        "validation": {
          "items": {
            "$ref": "#/$defs/ValidationCode"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Validation",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "page_number",
        "box",
        "printed_quote",
        "ocr_span_start",
        "ocr_span_end",
        "ocr_text_sha256",
        "rendered_page_sha256",
        "confidence",
        "validation"
      ],
      "title": "FieldEvidence",
      "type": "object"
    },
    "LabExtractionPayload": {
      "additionalProperties": false,
      "properties": {
        "analytes": {
          "items": {
            "$ref": "#/$defs/ProposedAnalyte"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Analytes",
          "type": "array"
        },
        "collection_date": {
          "$ref": "#/$defs/ProposedField_date_"
        }
      },
      "required": [
        "collection_date",
        "analytes"
      ],
      "title": "LabExtractionPayload",
      "type": "object"
    },
    "NormalizedBox": {
      "additionalProperties": false,
      "properties": {
        "height": {
