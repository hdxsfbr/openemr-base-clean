            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Height"
        },
        "width": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Width"
        },
        "x": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Y"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "NormalizedBox",
      "type": "object"
    },
    "OcrPage": {
      "additionalProperties": false,
      "properties": {
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "preprocessing_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Preprocessing Version",
          "type": "string"
        },
        "rendered_page_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rendered Page Sha256",
          "type": "string"
        },
        "renderer_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Renderer Version",
          "type": "string"
        },
        "text": {
          "maxLength": 100000,
          "title": "Text",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Sha256",
          "type": "string"
        },
        "tokens": {
          "items": {
            "$ref": "#/$defs/OcrToken"
          },
          "maxItems": 50000,
          "title": "Tokens",
          "type": "array"
        }
      },
      "required": [
        "page_number",
        "text",
        "text_sha256",
        "rendered_page_sha256",
        "renderer_version",
        "preprocessing_version"
      ],
      "title": "OcrPage",
      "type": "object"
    },
    "OcrToken": {
      "additionalProperties": false,
      "properties": {
        "box": {
          "$ref": "#/$defs/NormalizedBox"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Confidence"
        },
        "span_end": {
          "minimum": 1,
          "title": "Span End",
          "type": "integer"
        },
        "span_start": {
          "minimum": 0,
          "title": "Span Start",
          "type": "integer"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "token_index": {
          "minimum": 0,
          "title": "Token Index",
          "type": "integer"
        }
      },
      "required": [
        "token_index",
        "text",
        "span_start",
        "span_end",
        "box",
        "confidence"
      ],
      "title": "OcrToken",
      "type": "object"
    },
    "ProposedAnalyte": {
      "additionalProperties": false,
      "properties": {
        "abnormal_flag": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposedField_Literal__low____high____abnormal____normal____unknown___"
