        "analyte_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Analyte Id",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposedField_CodedValue_"
            },
