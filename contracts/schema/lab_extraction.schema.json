          "title": "Value"
        }
      },
      "required": [
        "field_id",
        "value",
        "state",
        "evidence"
      ],
      "title": "ProposedField[Annotated[Union[QuantityValue, TextValue], FieldInfo(annotation=NoneType, required=True, discriminator='kind')]]",
      "type": "object"
    },
