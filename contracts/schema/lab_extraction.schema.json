      "type": "integer"
    },
    "ocr_pages": {
      "items": {
        "$ref": "#/$defs/OcrPage"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Ocr Pages",
      "type": "array"
    },
    "payload": {
      "$ref": "#/$defs/LabExtractionPayload"
    },
    "schema_name": {
      "const": "lab-report",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceDocumentRef"
    },
    "state": {
      "$ref": "#/$defs/ExtractionState"
    }
  },
  "required": [
    "extraction_id",
    "extraction_version",
    "schema_name",
