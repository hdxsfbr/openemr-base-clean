{
  "$defs": {
    "EvidenceWorkerStatus": {
      "description": "The one terminal outcome emitted by the bounded local worker.",
      "enum": [
        "completed",
        "limited",
        "canceled"
      ],
      "title": "EvidenceWorkerStatus",
      "type": "string"
    },
    "EvidenceWorkerTimings": {
      "additionalProperties": false,
      "properties": {
        "dense_ms": {
          "maximum": 2000,
          "minimum": 0,
          "title": "Dense Ms",
          "type": "number"
        },
        "fusion_ms": {
          "maximum": 2000,
          "minimum": 0,
          "title": "Fusion Ms",
          "type": "number"
        },
        "rerank_ms": {
          "maximum": 2000,
          "minimum": 0,
          "title": "Rerank Ms",
          "type": "number"
        },
        "sparse_ms": {
          "maximum": 2000,
          "minimum": 0,
          "title": "Sparse Ms",
          "type": "number"
        },
        "total_ms": {
          "maximum": 2000,
          "minimum": 0,
          "title": "Total Ms",
          "type": "number"
        }
      },
      "required": [
        "sparse_ms",
        "dense_ms",
        "fusion_ms",
        "rerank_ms",
        "total_ms"
      ],
      "title": "EvidenceWorkerTimings",
      "type": "object"
    },
    "GuidelineExcerpt": {
      "additionalProperties": false,
      "description": "Exact publisher text and metadata returned only inside a trusted lane.",
      "properties": {
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "canonical_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Canonical Url",
          "type": "string"
        },
        "chunk_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "chunk_ordinal": {
          "minimum": 0,
          "title": "Chunk Ordinal",
          "type": "integer"
        },
        "chunk_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Chunk Sha256",
          "type": "string"
        },
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "corpus_retrieved_at": {
          "format": "date-time",
          "title": "Corpus Retrieved At",
          "type": "string"
        },
        "corpus_version": {
          "const": "uspstf-recommendations-2026-09-21-v2",
          "default": "uspstf-recommendations-2026-09-21-v2",
          "title": "Corpus Version",
          "type": "string"
        },
        "document_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Document Id",
          "type": "string"
        },
        "exact_text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Exact Text",
          "type": "string"
        },
        "jurisdiction": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Jurisdiction",
          "type": "string"
        },
        "publication_date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Date"
        },
        "publisher": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "section_path": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Section Path",
          "type": "array"
        },
        "source_id": {
          "maxLength": 240,
          "pattern": "^guideline:uspstf-recommendations-2026-09-21-v2:[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "topic": {
          "$ref": "#/$defs/GuidelineTopic"
        }
      },
      "required": [
        "source_id",
        "document_id",
        "chunk_id",
        "chunk_ordinal",
        "publisher",
        "title",
        "jurisdiction",
        "canonical_url",
        "topic",
        "section_path",
        "exact_text",
        "source_sha256",
        "chunk_sha256",
        "corpus_retrieved_at",
        "approved_at"
      ],
      "title": "GuidelineExcerpt",
      "type": "object"
    },
    "GuidelineRetrievalLimitation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/GuidelineRetrievalLimitationCode"
        },
        "detail": {
          "maxLength": 160,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "GuidelineRetrievalLimitation",
      "type": "object"
    },
    "GuidelineRetrievalLimitationCode": {
      "enum": [
        "guideline_retrieval_unavailable",
        "guideline_corpus_stale",
        "guideline_no_evidence",
        "guideline_query_rejected",
        "guideline_retrieval_timeout",
        "guideline_retrieval_canceled",
        "guideline_duplicate_handoff",
        "guideline_stale_handoff",
        "guideline_malformed_output"
      ],
      "title": "GuidelineRetrievalLimitationCode",
      "type": "string"
    },
    "GuidelineTopic": {
      "enum": [
        "aaa",
        "breast",
        "cervical",
        "colorectal",
        "lung",
        "child_obesity",
        "hypertension",
        "tobacco"
      ],
      "title": "GuidelineTopic",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A terminal worker envelope, never a final clinical claim or citation.\n\nThe later authenticated supervisor/resolver owns dispatch, source resolution,\nverification, and rendering.  This envelope contains only exact corpus\nexcerpts or one typed limitation.",
  "properties": {
    "artifact_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Artifact Manifest Sha256",
      "type": "string"
    },
    "candidate_count": {
      "maximum": 40,
      "minimum": 0,
      "title": "Candidate Count",
      "type": "integer"
    },
    "contract_version": {
      "const": "3.0.0",
      "default": "3.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "corpus_version": {
      "const": "uspstf-recommendations-2026-09-21-v2",
      "default": "uspstf-recommendations-2026-09-21-v2",
      "title": "Corpus Version",
      "type": "string"
    },
    "correlation_id": {
      "pattern": "^[A-Za-z0-9\\-._]{8,64}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "embedding_model_revision": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Embedding Model Revision",
      "type": "string"
    },
    "excerpts": {
      "items": {
        "$ref": "#/$defs/GuidelineExcerpt"
      },
      "maxItems": 5,
      "title": "Excerpts",
      "type": "array"
    },
    "handoff_id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Handoff Id",
      "type": "string"
    },
    "hit_count": {
      "maximum": 5,
      "minimum": 0,
      "title": "Hit Count",
      "type": "integer"
    },
    "limitation": {
      "anyOf": [
        {
          "$ref": "#/$defs/GuidelineRetrievalLimitation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reranker_model_revision": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Reranker Model Revision",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/EvidenceWorkerStatus"
    },
    "timings": {
      "$ref": "#/$defs/EvidenceWorkerTimings"
    },
    "worker_revision": {
      "const": "evidence-retriever-local-v1",
      "default": "evidence-retriever-local-v1",
      "title": "Worker Revision",
      "type": "string"
    }
  },
  "required": [
    "correlation_id",
    "handoff_id",
    "status",
    "artifact_manifest_sha256",
    "embedding_model_revision",
    "reranker_model_revision",
    "candidate_count",
    "hit_count",
    "timings"
  ],
  "title": "EvidenceWorkerResult",
  "type": "object",
  "x-contract-version": "1.2.0"
}
