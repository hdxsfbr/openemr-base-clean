{
  "$defs": {
    "GuidelineTopic": {
      "enum": [
        "aaa",
        "breast",
        "cervical",
        "colorectal",
        "lung",
        "child_obesity",
        "hypertension",
        "tobacco"
      ],
      "title": "GuidelineTopic",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact publisher text and metadata returned only inside a trusted lane.",
  "properties": {
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    },
    "canonical_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Canonical Url",
      "type": "string"
    },
    "chunk_id": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Chunk Id",
      "type": "string"
    },
    "chunk_ordinal": {
      "minimum": 0,
      "title": "Chunk Ordinal",
      "type": "integer"
    },
    "chunk_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Chunk Sha256",
      "type": "string"
    },
    "contract_version": {
      "const": "3.0.0",
      "default": "3.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "corpus_retrieved_at": {
      "format": "date-time",
      "title": "Corpus Retrieved At",
      "type": "string"
    },
    "corpus_version": {
      "const": "uspstf-recommendations-2026-09-21-v2",
      "default": "uspstf-recommendations-2026-09-21-v2",
      "title": "Corpus Version",
      "type": "string"
    },
    "document_id": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Document Id",
      "type": "string"
    },
    "exact_text": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Exact Text",
      "type": "string"
    },
    "jurisdiction": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Jurisdiction",
      "type": "string"
    },
    "publication_date": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication Date"
    },
    "publisher": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Publisher",
      "type": "string"
    },
    "section_path": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Section Path",
      "type": "array"
    },
    "source_id": {
      "maxLength": 240,
      "pattern": "^guideline:uspstf-recommendations-2026-09-21-v2:[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Source Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "topic": {
      "$ref": "#/$defs/GuidelineTopic"
    }
  },
  "required": [
    "source_id",
    "document_id",
    "chunk_id",
    "chunk_ordinal",
    "publisher",
    "title",
    "jurisdiction",
    "canonical_url",
    "topic",
    "section_path",
    "exact_text",
    "source_sha256",
    "chunk_sha256",
    "corpus_retrieved_at",
    "approved_at"
  ],
  "title": "GuidelineExcerpt",
  "type": "object",
  "x-contract-version": "1.2.0"
}
