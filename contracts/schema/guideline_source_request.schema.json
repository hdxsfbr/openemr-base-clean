{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A reauthorized click may reopen only an evidence item saved for its turn.",
  "properties": {
    "evidence_turn_id": {
      "pattern": "^[a-f0-9]{16}$",
      "title": "Evidence Turn Id",
      "type": "string"
    },
    "source_id": {
      "maxLength": 240,
      "pattern": "^guideline:uspstf-recommendations-2026-09-21-v2:[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "evidence_turn_id",
    "source_id"
  ],
  "title": "GuidelineSourceRequest",
  "type": "object",
  "x-contract-version": "1.2.0"
}
