{
  "$defs": {
    "AbsenceState": {
      "enum": [
        "documented",
        "reviewed_none",
        "not_documented"
      ],
      "title": "AbsenceState",
      "type": "string"
    },
    "AllergyRecord": {
      "additionalProperties": false,
      "properties": {
        "begin": {
          "$ref": "#/$defs/ClinicalDate"
        },
        "reaction": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reaction"
        },
        "severity": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "status": {
          "enum": [
            "active",
            "inactive",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "substance": {
          "maxLength": 255,
          "title": "Substance",
          "type": "string"
        },
        "undated": {
          "title": "Undated",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "substance",
        "status",
        "begin",
        "undated"
      ],
      "title": "AllergyRecord",
      "type": "object"
    },
    "ClinicalDate": {
      "additionalProperties": false,
      "description": "A date with its precision and provenance, so undated and maintenance-stamped\nrows are never mistaken for clinical events (DQ-HIGH-004, DQ-MEDIUM-006).",
      "properties": {
        "basis": {
          "$ref": "#/$defs/DateBasis",
          "default": "unknown"
        },
        "precision": {
          "$ref": "#/$defs/DatePrecision",
          "default": "unknown"
        },
        "value": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "ClinicalDate",
      "type": "object"
    },
    "Code": {
      "additionalProperties": false,
      "properties": {
        "as_written": {
          "description": "Exactly as stored; no translation (DQ-HIGH-005)",
          "maxLength": 128,
          "title": "As Written",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "system": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System"
        }
      },
      "required": [
        "as_written"
      ],
      "title": "Code",
      "type": "object"
    },
    "DateBasis": {
      "enum": [
        "clinical",
        "entered",
        "modified",
        "unknown"
      ],
      "title": "DateBasis",
      "type": "string"
    },
    "DatePrecision": {
      "enum": [
        "day",
        "datetime",
        "unknown"
      ],
      "title": "DatePrecision",
      "type": "string"
    },
    "EncounterRecord": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "class_code": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class Code"
        },
        "date": {
          "$ref": "#/$defs/ClinicalDate"
        },
        "encounter_id": {
          "title": "Encounter Id",
          "type": "integer"
        },
        "is_clinical_visit": {
          "description": "Reference-encounter candidate (UC-01)",
          "title": "Is Clinical Visit",
          "type": "boolean"
        },
        "provider": {
          "$ref": "#/$defs/Person"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "sensitivity": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensitivity"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "source",
        "encounter_id",
        "date",
        "is_clinical_visit"
      ],
      "title": "EncounterRecord",
      "type": "object"
    },
    "LabResultRecord": {
      "additionalProperties": false,
      "properties": {
        "analyte": {
          "maxLength": 255,
          "title": "Analyte",
          "type": "string"
        },
        "analyte_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analyte Code"
        },
        "comparable": {
          "description": "numeric value with a non-empty unit",
          "title": "Comparable",
          "type": "boolean"
        },
        "corrected": {
          "default": false,
          "title": "Corrected",
          "type": "boolean"
        },
        "date": {
          "$ref": "#/$defs/ClinicalDate"
        },
        "flag": {
          "enum": [
            "abnormal",
            "normal",
            "unknown"
          ],
          "title": "Flag",
          "type": "string"
        },
        "flag_as_recorded": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flag As Recorded"
        },
        "numeric_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set only when value_text is strictly numeric",
          "title": "Numeric Value"
        },
        "order_id": {
          "title": "Order Id",
          "type": "integer"
        },
        "range_text": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range Text"
        },
        "report_id": {
          "title": "Report Id",
          "type": "integer"
        },
        "result_status": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Status"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value_text": {
          "description": "Exactly as stored",
          "maxLength": 255,
          "title": "Value Text",
          "type": "string"
        }
      },
      "required": [
        "source",
        "order_id",
        "report_id",
        "analyte",
        "value_text",
        "flag",
        "date",
        "comparable"
      ],
      "title": "LabResultRecord",
      "type": "object"
    },
    "MedicationRecord": {
      "additionalProperties": false,
      "properties": {
        "codes": {
          "items": {
            "$ref": "#/$defs/Code"
          },
          "title": "Codes",
          "type": "array"
        },
        "documented_indication": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only what the row records; never inferred",
          "title": "Documented Indication"
        },
        "dose_text": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Resolved labels, never option ids (DQ-MEDIUM-010)",
          "title": "Dose Text"
        },
        "end": {
          "$ref": "#/$defs/ClinicalDate"
        },
        "name": {
          "maxLength": 255,
          "title": "Name",
          "type": "string"
        },
        "prescriber": {
          "$ref": "#/$defs/Person"
        },
        "provenance": {
          "enum": [
            "lists",
            "prescriptions"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "start": {
          "$ref": "#/$defs/ClinicalDate"
        },
        "status": {
          "enum": [
            "active",
            "inactive",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "status_basis": {
          "enum": [
            "enddate",
            "activity",
            "both",
            "none"
          ],
          "title": "Status Basis",
          "type": "string"
        },
        "status_conflict": {
          "description": "enddate and activity disagree (DQ-HIGH-002)",
          "title": "Status Conflict",
          "type": "boolean"
        },
        "undated": {
          "title": "Undated",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "provenance",
        "name",
        "start",
        "end",
        "status",
        "status_basis",
        "status_conflict",
        "undated"
      ],
      "title": "MedicationRecord",
      "type": "object"
    },
    "NoteRecord": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "$ref": "#/$defs/Person"
        },
        "date": {
          "$ref": "#/$defs/ClinicalDate"
        },
        "encounter_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encounter Id"
        },
        "note_type": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note Type"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "term_matched": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Term Matched"
        },
        "text": {
          "maxLength": 4000,
          "title": "Text",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "date",
        "text"
      ],
      "title": "NoteRecord",
      "type": "object"
    },
    "PatientContextRecord": {
      "additionalProperties": false,
      "properties": {
        "age_band": {
          "description": "e.g. 60-69; never the date of birth",
          "maxLength": 16,
          "title": "Age Band",
          "type": "string"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Section row counts for the panel header",
          "title": "Counts",
          "type": "object"
        },
        "sex": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sex"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "source",
        "age_band"
      ],
      "title": "PatientContextRecord",
      "type": "object"
    },
    "Person": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display"
        },
        "unknown": {
          "default": false,
          "title": "Unknown",
          "type": "boolean"
        },
        "username": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        }
      },
      "title": "Person",
      "type": "object"
    },
    "ProblemRecord": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "$ref": "#/$defs/Person"
        },
        "begin": {
          "$ref": "#/$defs/ClinicalDate"
        },
        "codes": {
          "items": {
            "$ref": "#/$defs/Code"
          },
          "title": "Codes",
          "type": "array"
        },
        "end": {
          "$ref": "#/$defs/ClinicalDate"
        },
        "linked_encounter_count": {
          "default": 0,
          "title": "Linked Encounter Count",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "status": {
          "enum": [
            "active",
            "inactive",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "maxLength": 255,
          "title": "Title",
          "type": "string"
        },
        "undated": {
          "description": "No clinical begin date; cannot be placed in a timeline",
          "title": "Undated",
          "type": "boolean"
        },
        "verification": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification"
        }
      },
      "required": [
        "source",
        "title",
        "status",
        "begin",
        "end",
        "undated"
      ],
      "title": "ProblemRecord",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Where a record came from. `source_id` is what claims cite and what the\nmodule maps to a chart URL.",
      "properties": {
        "id": {
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "source_id": {
          "maxLength": 240,
          "pattern": "^(openemr|document|guideline):[A-Za-z0-9_\\-.:]{1,200}$",
          "title": "Source Id",
          "type": "string"
        },
        "table": {
          "maxLength": 64,
          "title": "Table",
          "type": "string"
        },
        "uuid": {
          "anyOf": [
            {
              "maxLength": 36,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uuid"
        }
      },
      "required": [
        "source_id",
        "table",
        "id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "ToolStatus": {
      "enum": [
        "ok",
        "empty",
        "partial",
        "unavailable"
      ],
      "title": "ToolStatus",
      "type": "string"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Since"
        },
        "until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until"
        }
      },
      "title": "Window",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The envelope every tool returns. `status` is never inferred from an empty\nlist: `empty` means retrieval succeeded and found nothing, `unavailable`\nmeans it did not succeed (PERF-MED-001).",
  "properties": {
    "absence_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/AbsenceState"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Allergies: reviewed_none vs not_documented (DQ-MEDIUM-007)"
    },
    "contract_version": {
      "maxLength": 16,
      "title": "Contract Version",
      "type": "string"
    },
    "correlation_id": {
      "pattern": "^[A-Za-z0-9\\-._]{8,64}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "number"
    },
    "omitted_count": {
      "default": 0,
      "minimum": 0,
      "title": "Omitted Count",
      "type": "integer"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "records": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/PatientContextRecord"
          },
          {
            "$ref": "#/$defs/EncounterRecord"
          },
          {
            "$ref": "#/$defs/NoteRecord"
          },
          {
            "$ref": "#/$defs/ProblemRecord"
          },
          {
            "$ref": "#/$defs/MedicationRecord"
          },
          {
            "$ref": "#/$defs/AllergyRecord"
          },
          {
            "$ref": "#/$defs/LabResultRecord"
          }
        ]
      },
      "title": "Records",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ToolStatus"
    },
    "tool": {
      "enum": [
        "patient_context",
        "encounters",
        "clinical_notes",
        "problems",
        "medications",
        "allergies",
        "lab_results"
      ],
      "title": "Tool",
      "type": "string"
    },
    "tool_version": {
      "maxLength": 16,
      "title": "Tool Version",
      "type": "string"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    },
    "window": {
      "$ref": "#/$defs/Window"
    }
  },
  "required": [
    "tool",
    "tool_version",
    "contract_version",
    "status",
    "latency_ms",
    "correlation_id"
  ],
  "title": "ToolResponse",
  "type": "object",
  "x-contract-version": "1.2.0"
}
