{
  "$defs": {
    "ChoiceAnswer": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "choice",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "enum": [
            "female",
            "male",
            "other",
            "unknown",
            "active",
            "inactive",
            "stopped",
            "resolved",
            "mild",
            "moderate",
            "severe",
            "low",
            "high",
            "abnormal",
            "normal"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "ChoiceAnswer",
      "type": "object"
    },
    "ClaimFacts": {
      "additionalProperties": false,
      "description": "Typed facts the verifier checks field by field. Flat so structured\noutput can emit it reliably; each claim type uses its own subset.",
      "properties": {
        "analyte": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_result, lab_comparison",
          "title": "Analyte"
        },
        "date": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM-DD for change_event and lab_result",
          "title": "Date"
        },
        "direction": {
          "anyOf": [
            {
              "maxLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_comparison: up|down|same",
          "title": "Direction"
        },
        "earlier_source_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_comparison",
          "title": "Earlier Source Id"
        },
        "flag": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_result: abnormal|normal|unknown",
          "title": "Flag"
        },
        "kind": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "change_event: added|ended|started|stopped|resulted|noted; conflict: status_conflict|note_vs_list|duplicate_sources",
          "title": "Kind"
        },
        "later_source_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_comparison",
          "title": "Later Source Id"
        },
        "medication_name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "documented_reference",
          "title": "Medication Name"
        },
        "mention": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "documented_reference: short quote from the cited note",
          "title": "Mention"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "medication_status: medication name; problem_status: problem title as written",
          "title": "Name"
        },
        "reading": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "interpretation: your reading of an ambiguous reference",
          "title": "Reading"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "change_event, absence, undated",
          "title": "Section"
        },
        "state": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "absence: not_documented|reviewed_none|no_records_in_window",
          "title": "State"
        },
        "status": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "medication_status, problem_status: active|inactive|unknown",
          "title": "Status"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_result: exactly as in the pack, null if missing",
          "title": "Unit"
        },
        "value_text": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lab_result: exactly as in the pack",
          "title": "Value Text"
        }
      },
      "title": "ClaimFacts",
      "type": "object"
    },
    "DateAnswer": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "date",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "format": "date",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "DateAnswer",
      "type": "object"
    },
    "GuidelineClaimCandidate": {
      "additionalProperties": false,
      "properties": {
        "claim_class": {
          "const": "guideline_evidence",
          "title": "Claim Class",
          "type": "string"
        },
        "facts": {
          "$ref": "#/$defs/GuidelineExcerptFacts"
        },
        "id": {
          "pattern": "^c[0-9]{1,3}$",
          "title": "Id",
          "type": "string"
        },
        "section": {
          "const": "guideline_evidence",
          "title": "Section",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "maxLength": 240,
            "pattern": "^guideline:[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}$",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "type": {
          "const": "guideline_excerpt",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "claim_class",
        "type",
        "facts",
        "source_ids",
        "section"
      ],
      "title": "GuidelineClaimCandidate",
      "type": "object"
    },
    "GuidelineExcerptFacts": {
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "section_path": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Section Path",
          "type": "array"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "topic": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "quote",
        "publisher",
        "title",
        "topic",
        "section_path"
      ],
      "title": "GuidelineExcerptFacts",
      "type": "object"
    },
    "IntakeAnswerFacts": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "discriminator": {
            "mapping": {
              "choice": "#/$defs/ChoiceAnswer",
              "date": "#/$defs/DateAnswer",
              "integer": "#/$defs/IntegerAnswer",
              "string": "#/$defs/StringAnswer"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/StringAnswer"
            },
            {
              "$ref": "#/$defs/DateAnswer"
            },
            {
              "$ref": "#/$defs/IntegerAnswer"
            },
            {
              "$ref": "#/$defs/ChoiceAnswer"
            }
          ],
          "title": "Answer"
        },
        "link_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Link Id",
          "type": "string"
        },
        "repeat_key": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeat Key"
        }
      },
      "required": [
        "link_id",
        "answer"
      ],
      "title": "IntakeAnswerFacts",
      "type": "object"
    },
    "IntegerAnswer": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "integer",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maximum": 130,
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "IntegerAnswer",
      "type": "object"
    },
    "PatientClaimCandidate": {
      "additionalProperties": false,
      "properties": {
        "claim_class": {
          "const": "patient_record",
          "title": "Claim Class",
          "type": "string"
        },
        "facts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaimFacts"
            },
            {
              "$ref": "#/$defs/IntakeAnswerFacts"
            }
          ],
          "title": "Facts"
        },
        "id": {
          "pattern": "^c[0-9]{1,3}$",
          "title": "Id",
          "type": "string"
        },
        "section": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "anyOf": [
              {
                "maxLength": 240,
                "pattern": "^openemr:[A-Za-z0-9_-]{1,64}:[0-9]+(?::[0-9a-f-]{36})?$",
                "type": "string"
              },
              {
                "maxLength": 240,
                "pattern": "^document:[0-9a-f-]{36}:record:[0-9a-f-]{36}:v:[1-9][0-9]*:field:[a-z][a-z0-9_.-]{0,127}$",
                "type": "string"
              }
            ]
          },
          "maxItems": 8,
          "title": "Source Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "enum": [
            "change_event",
            "medication_status",
            "problem_status",
            "lab_result",
            "lab_comparison",
            "documented_reference",
            "absence",
            "conflict",
            "undated",
            "intake_answer"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "claim_class",
        "type",
        "text",
        "facts",
        "source_ids",
        "section"
      ],
      "title": "PatientClaimCandidate",
      "type": "object"
    },
    "StringAnswer": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "string",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "StringAnswer",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "guideline_evidence": "#/$defs/GuidelineClaimCandidate",
      "patient_record": "#/$defs/PatientClaimCandidate"
    },
    "propertyName": "claim_class"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PatientClaimCandidate"
    },
    {
      "$ref": "#/$defs/GuidelineClaimCandidate"
    }
  ],
  "title": "ClaimCandidate",
  "x-contract-version": "2.0.0"
}
