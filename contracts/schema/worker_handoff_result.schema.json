{
  "$defs": {
    "StageTiming": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "completed",
            "limited",
            "failed",
            "canceled"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "stage": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "duration_ms",
        "outcome"
      ],
      "title": "StageTiming",
      "type": "object"
    },
    "VersionedReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "integrity_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integrity Sha256"
        },
        "kind": {
          "enum": [
            "source_document",
            "extraction",
            "evidence_query",
            "evidence_result",
            "corpus",
            "reviewed_record"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "title": "VersionedReference",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "maximum": 2,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "contract_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 8,
      "minProperties": 1,
      "title": "Contract Versions",
      "type": "object"
    },
    "conversation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Id"
    },
    "correlation_id": {
      "pattern": "^[A-Za-z0-9\\-._]{8,64}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_kind": {
      "enum": [
        "document_uploaded",
        "reprocess_requested",
        "chat_turn"
      ],
      "title": "Event Kind",
      "type": "string"
    },
    "handoff_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Handoff Id",
      "type": "string"
    },
    "limitation_codes": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Limitation Codes",
      "type": "array"
    },
    "output_refs": {
      "items": {
        "$ref": "#/$defs/VersionedReference"
      },
      "maxItems": 8,
      "title": "Output Refs",
      "type": "array"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    },
    "stage_timings": {
      "items": {
        "$ref": "#/$defs/StageTiming"
      },
      "maxItems": 16,
      "title": "Stage Timings",
      "type": "array"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "unavailable",
        "failed",
        "canceled"
      ],
      "title": "Status",
      "type": "string"
    },
    "turn_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Id"
    },
    "worker": {
      "enum": [
        "intake_extractor",
        "evidence_retriever"
      ],
      "title": "Worker",
      "type": "string"
    }
  },
  "required": [
    "handoff_id",
    "correlation_id",
    "event_kind",
    "worker",
    "attempt",
    "status",
    "output_refs",
    "limitation_codes",
    "retryable",
    "stage_timings",
    "contract_versions"
  ],
  "title": "WorkerHandoffResult",
  "type": "object",
  "x-contract-version": "2.0.0"
}
