        "review_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Review Id",
          "type": "string"
        },
        "source_field_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Source Field Id",
          "type": "string"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "quantity": "#/$defs/QuantityValue",
              "text": "#/$defs/TextValue"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/QuantityValue"
            },
            {
              "$ref": "#/$defs/TextValue"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "source_field_id",
        "review_id",
        "evidence_ids"
      ],
      "title": "ReviewedField[Annotated[Union[QuantityValue, TextValue], FieldInfo(annotation=NoneType, required=True, discriminator='kind')]]",
      "type": "object"
    },
