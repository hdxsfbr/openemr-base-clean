        "analyte_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Analyte Id",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewedField_CodedValue_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewedField_ReferenceRange_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "test_name": {
          "$ref": "#/$defs/ReviewedField_Annotated_str__FieldInfo_annotation_NoneType__required_True__metadata__MinLen_min_length_1___MaxLen_max_length_200_____"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewedField_Annotated_str__FieldInfo_annotation_NoneType__required_True__metadata__MinLen_min_length_1___MaxLen_max_length_80_____"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "$ref": "#/$defs/ReviewedField_Annotated_Union_QuantityValue__TextValue___FieldInfo_annotation_NoneType__required_True__discriminator__kind____"
        }
      },
      "required": [
        "analyte_id",
        "test_name",
        "value"
      ],
      "title": "ReviewedAnalyte",
      "type": "object"
    },
    "ReviewedField_Annotated_Union_QuantityValue__TextValue___FieldInfo_annotation_NoneType__required_True__discriminator__kind____": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
