{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detail": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Detail",
      "type": "string"
    },
    "kind": {
      "enum": [
        "not_documented",
        "reviewed_none",
        "unavailable",
        "truncated",
        "conflict",
        "undated",
        "withheld",
        "out_of_scope",
        "narrative_unavailable",
        "model_budget_exhausted",
        "guideline_no_evidence",
        "guideline_stale",
        "guideline_retrieval_unavailable"
      ],
      "title": "Kind",
      "type": "string"
    },
    "section": {
      "anyOf": [
        {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Section"
    },
    "source_ids": {
      "items": {
        "anyOf": [
          {
            "maxLength": 240,
            "pattern": "^openemr:[A-Za-z0-9_-]{1,64}:[0-9]+(?::[0-9a-f-]{36})?$",
            "type": "string"
          },
          {
            "maxLength": 240,
            "pattern": "^document:[0-9a-f-]{36}:record:[0-9a-f-]{36}:v:[1-9][0-9]*:field:[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          {
            "maxLength": 240,
            "pattern": "^guideline:[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}$",
            "type": "string"
          }
        ]
      },
      "maxItems": 8,
      "title": "Source Ids",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "detail",
    "source_ids"
  ],
  "title": "Week2Limitation",
  "type": "object",
  "x-contract-version": "2.0.0"
}
