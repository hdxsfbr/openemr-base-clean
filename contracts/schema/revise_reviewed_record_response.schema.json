{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Action Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "created",
        "replayed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "record_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Record Id",
      "type": "string"
    },
    "record_version": {
      "minimum": 2,
      "title": "Record Version",
      "type": "integer"
    },
    "review_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Set Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "amended",
        "withdrawn",
        "stopped"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "action_id",
    "record_id",
    "record_version",
    "status",
    "review_set_sha256",
    "outcome"
  ],
  "title": "ReviseReviewedRecordResponse",
  "type": "object",
  "x-contract-version": "2.0.0"
}
