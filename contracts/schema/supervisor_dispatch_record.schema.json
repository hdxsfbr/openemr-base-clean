{
  "$defs": {
    "DocumentInputReference": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "document_type": {
          "$ref": "#/$defs/DocumentType"
        },
        "kind": {
          "const": "document_source",
          "default": "document_source",
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "maxLength": 41,
          "pattern": "^document:[a-f0-9]{32}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "document_type",
        "contract_version"
      ],
      "title": "DocumentInputReference",
      "type": "object"
    },
    "DocumentType": {
      "description": "The only two Week 2 source types accepted at the upload boundary.",
      "enum": [
        "lab_pdf",
        "intake_form"
      ],
      "title": "DocumentType",
      "type": "string"
    },
    "EvidenceInputReference": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "corpus_version": {
          "const": "uspstf-recommendations-2026-09-21-v2",
          "default": "uspstf-recommendations-2026-09-21-v2",
          "title": "Corpus Version",
          "type": "string"
        },
        "kind": {
          "const": "evidence_request",
          "default": "evidence_request",
          "title": "Kind",
          "type": "string"
        },
        "request_ref": {
          "maxLength": 64,
          "pattern": "^[a-f0-9]{16,64}$",
          "title": "Request Ref",
          "type": "string"
        }
      },
      "required": [
        "request_ref",
        "contract_version"
      ],
      "title": "EvidenceInputReference",
      "type": "object"
    },
    "RouteReason": {
      "enum": [
        "document_event",
        "patient_record_only",
        "explicit_control",
        "explicit_guideline_terms",
        "evidence_for_supported_finding",
        "ambiguous",
        "disallowed_advice"
      ],
      "title": "RouteReason",
      "type": "string"
    },
    "SupervisorEventKind": {
      "enum": [
        "document_uploaded",
        "reprocess_requested",
        "chat_turn"
      ],
      "title": "SupervisorEventKind",
      "type": "string"
    },
    "SupervisorWorker": {
      "enum": [
        "intake_extractor",
        "evidence_retriever"
      ],
      "title": "SupervisorWorker",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "const": 1,
      "default": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "contract_version": {
      "const": "4.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "correlation_id": {
      "pattern": "^[A-Za-z0-9\\-._]{8,64}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "deadline_unix_ms": {
      "maximum": 4102444800000,
      "minimum": 1,
      "title": "Deadline Unix Ms",
      "type": "integer"
    },
    "event_kind": {
      "$ref": "#/$defs/SupervisorEventKind"
    },
    "handoff_id": {
      "maxLength": 32,
      "pattern": "^[a-f0-9]{32}$",
      "title": "Handoff Id",
      "type": "string"
    },
    "input_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocumentInputReference"
        },
        {
          "$ref": "#/$defs/EvidenceInputReference"
        }
      ],
      "title": "Input Ref"
    },
    "reason": {
      "$ref": "#/$defs/RouteReason"
    },
    "status": {
      "const": "dispatched",
      "default": "dispatched",
      "title": "Status",
      "type": "string"
    },
    "worker": {
      "$ref": "#/$defs/SupervisorWorker"
    }
  },
  "required": [
    "contract_version",
    "correlation_id",
    "handoff_id",
    "event_kind",
    "worker",
    "reason",
    "deadline_unix_ms",
    "input_ref"
  ],
  "title": "DispatchRecord",
  "type": "object",
  "x-contract-version": "4.0.0"
}
