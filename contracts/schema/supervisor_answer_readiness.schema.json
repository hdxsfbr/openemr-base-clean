        "unauthorized_event",
        "unsupported_event",
        "stale_handoff",
        "duplicate_terminal",
        "wrong_worker",
        "correlation_mismatch",
        "contract_version_mismatch",
        "malformed_transition",
        "deadline_exceeded",
        "worker_unavailable",
        "worker_canceled",
        "no_evidence"
