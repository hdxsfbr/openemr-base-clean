#cloud-config
ssh_pwauth: false

write_files:
  - path: /etc/apt/keyrings/docker.asc
    permissions: "0644"
    source:
      uri: https://download.docker.com/linux/ubuntu/gpg
  - path: /etc/apt/sources.list.d/docker.list
    permissions: "0644"
    content: |
      deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable
  - path: /etc/apt/keyrings/gitlab-runner.asc
    permissions: "0644"
    source:
      uri: https://packages.gitlab.com/runner/gitlab-runner/gpgkey
  - path: /etc/apt/sources.list.d/gitlab-runner.list
    permissions: "0644"
    content: |
      deb [signed-by=/etc/apt/keyrings/gitlab-runner.asc] https://packages.gitlab.com/runner/gitlab-runner/ubuntu/ noble main
  - path: /etc/ssh/sshd_config.d/60-agentforge.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password

# 1 GB of RAM plus a 2 GB swap file keeps a pip install inside a job from being OOM-killed.
swap:
  filename: /swapfile
  size: 2G
  maxsize: 2G

package_update: true
packages:
  - docker-ce
  - docker-ce-cli
  - containerd.io
  - gitlab-runner

runcmd:
  - [systemctl, enable, --now, docker]
  - [systemctl, enable, --now, gitlab-runner]
  - [systemctl, try-reload-or-restart, ssh]

final_message: "AgentForge CI runner host bootstrap complete"
