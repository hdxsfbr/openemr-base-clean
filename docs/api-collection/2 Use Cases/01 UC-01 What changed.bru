meta {
  name: 01 UC-01 What changed
  type: http
  seq: 1
}

post {
  url: {{agent_base}}/v1/conversations/{{conversation_id}}/turns
  body: json
  auth: none
}

headers {
  X-Copilot-Token: {{ticket}}
  X-Correlation-Id: {{turn_correlation}}
}

body:json {
  {
    "message": "What changed since the last visit?",
    "correlation_id": "{{turn_correlation}}",
    "stream": false
  }
}

script:pre-request {
  const r = await bru.runRequest("1 Session/05 Ticket");
  bru.setVar("ticket", r.data.token);
  bru.setVar("turn_correlation", r.data.correlation_id);
}

assert {
  res.status: eq 200
  res.body.turn_type: eq uc01_first
  res.body.correlation_id: eq {{turn_correlation}}
  res.body.verification: isDefined
  res.body.contract_version: eq 1.0.0
}

tests {
  test("every claim cites a source", function () {
    const claims = res.getBody().claims || [];
    claims.forEach(c => { if (c.type !== "absence" && c.type !== "interpretation") { expect(c.source_ids.length).to.be.greaterThan(0); } });
  });
  test("evidence covers the six clinical tools", function () {
    const tools = (res.getBody().evidence || []).map(e => e.tool);
    ["encounters", "problems", "medications", "allergies", "lab_results", "clinical_notes"].forEach(t => expect(tools).to.include(t));
  });
  test("correlation id echoed in header", function () {
    expect(res.getHeader("x-correlation-id")).to.equal(bru.getVar("turn_correlation"));
  });
}
