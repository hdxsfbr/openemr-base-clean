meta {
  name: 03 UC-02 Unresolved labs
  type: http
  seq: 3
}

post {
  url: {{agent_base}}/v1/conversations/{{conversation_id}}/turns
  body: json
  auth: none
}

headers {
  X-Copilot-Token: {{ticket}}
  X-Correlation-Id: {{turn_correlation}}
}

body:json {
  {
    "message": "Which recent abnormal labs still have no later result or documented follow-up?",
    "correlation_id": "{{turn_correlation}}",
    "stream": false
  }
}

script:pre-request {
  const r = await bru.runRequest("1 Session/05 Ticket");
  bru.setVar("ticket", r.data.token);
  bru.setVar("turn_correlation", r.data.correlation_id);
}

assert {
  res.status: eq 200
  res.body.turn_type: eq followup
}

tests {
  test("no resolution language in any claim", function () {
    (res.getBody().claims || []).forEach(c => expect(c.text.toLowerCase()).to.not.match(/\bresolved\b/));
  });
}
