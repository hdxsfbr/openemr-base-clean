meta {
  name: 02 UC-01 Follow-up
  type: http
  seq: 2
}

post {
  url: {{agent_base}}/v1/conversations/{{conversation_id}}/turns
  body: json
  auth: none
}

headers {
  X-Copilot-Token: {{ticket}}
  X-Correlation-Id: {{turn_correlation}}
}

body:json {
  {
    "message": "Was the amlodipine stop documented in a note?",
    "correlation_id": "{{turn_correlation}}",
    "stream": false
  }
}

script:pre-request {
  const r = await bru.runRequest("1 Session/05 Ticket");
  bru.setVar("ticket", r.data.token);
  bru.setVar("turn_correlation", r.data.correlation_id);
}

assert {
  res.status: eq 200
  res.body.turn_type: eq followup
  res.body.verification: isDefined
}
