meta {
  name: 04 UC-03 Medication evidence
  type: http
  seq: 4
}

post {
  url: {{agent_base}}/v1/conversations/{{conversation_id}}/turns
  body: json
  auth: none
}

headers {
  X-Copilot-Token: {{ticket}}
  X-Correlation-Id: {{turn_correlation}}
}

body:json {
  {
    "message": "What does the chart say about why metformin is on the list?",
    "correlation_id": "{{turn_correlation}}",
    "stream": false
  }
}

script:pre-request {
  const r = await bru.runRequest("1 Session/05 Ticket");
  bru.setVar("ticket", r.data.token);
  bru.setVar("turn_correlation", r.data.correlation_id);
}

assert {
  res.status: eq 200
}

tests {
  test("no indication inference wording", function () {
    (res.getBody().claims || []).forEach(c => expect(c.text.toLowerCase()).to.not.match(/\btreat/));
  });
}
